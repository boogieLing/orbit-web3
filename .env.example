# 仅在本地原生 API 进程显式加载；发布环境通过 Sites secrets 设置。
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
COMPOSE_URL=
COMPOSE_API_KEY=
COMPOSE_MODEL=

# 笔试体验入口，关闭后使用钱包与外部服务路径。
USEDIT_EXPERIENCE_MODE=true

# 应用创作只由服务端调用；凭据不能使用 NEXT_PUBLIC_ 前缀。
STUDIO_URL=https://api.deepseek.com/chat/completions
STUDIO_API_KEY=
STUDIO_MODEL=deepseek-flash
STUDIO_PROVIDER=DeepSeek
